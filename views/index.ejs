    <!-- AOS Script -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <!-- Certificates JSON Data Container (isolates EJS templating from JS syntax validator) -->
    <script type="application/json" id="certificates-data">
        <%- JSON.stringify(certificatesList) %>
    </script>

    <!-- Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            AOS.init({
                duration: 700,
                once: true,
                offset: 50
            });

            // Typewriter
            const phrases = [
                "Full Stack Developer",
                "AWS Certified Cloud Practitioner",
                "MCA Graduate Student",
                "React & Node.js Developer"
            ];
            let pIdx = 0, lIdx = 0, isDel = false;
            const typeEl = document.getElementById('typewriter-text');
            const prefixEl = document.getElementById('typewriter-prefix');

            function runTypewriter() {
                if (!typeEl) return;
                const cur = phrases[pIdx];

                if (prefixEl) {
                    prefixEl.textContent = (cur === "MCA Graduate Student" || cur.startsWith("AWS")) ? "I am an" : "I am a";
                }

                if (isDel) {
                    typeEl.textContent = cur.substring(0, lIdx - 1);
                    lIdx--;
                } else {
                    typeEl.textContent = cur.substring(0, lIdx + 1);
                    lIdx++;
                }

                if (!isDel && lIdx === cur.length) {
                    setTimeout(() => { isDel = true; runTypewriter(); }, 1800);
                } else if (isDel && lIdx === 0) {
                    isDel = false;
                    pIdx = (pIdx + 1) % phrases.length;
                    setTimeout(runTypewriter, 300);
                } else {
                    setTimeout(runTypewriter, isDel ? 45 : 90);
                }
            }
            runTypewriter();

            // Mobile menu drawer
            const mobileBtn = document.getElementById('mobile-menu-btn');
            const closeBtn = document.getElementById('close-sidebar');
            const sidebar = document.getElementById('sidebar-menu');
            const backdrop = document.getElementById('sidebar-backdrop');
            const sidebarLinks = document.querySelectorAll('.sidebar-link');

            function openM() {
                sidebar.classList.remove('translate-x-full');
                backdrop.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
            function closeM() {
                sidebar.classList.add('translate-x-full');
                backdrop.classList.add('hidden');
                document.body.style.overflow = '';
            }

            if (mobileBtn) mobileBtn.addEventListener('click', openM);
            if (closeBtn) closeBtn.addEventListener('click', closeM);
            if (backdrop) backdrop.addEventListener('click', closeM);
            sidebarLinks.forEach(l => l.addEventListener('click', closeM));

            // Form
            const form = document.getElementById('contact-form');
            const msg = document.getElementById('form-message');

            if (form) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const btn = form.querySelector('button[type="submit"]');
                    const orig = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<span>Sending...</span>';

                    const payload = {
                        name: document.getElementById('name').value.trim(),
                        email: document.getElementById('email').value.trim(),
                        message: document.getElementById('message').value.trim()
                    };

                    try {
                        const res = await fetch('/contact', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();
                        msg.classList.remove('hidden');
                        if (data.success) {
                            msg.className = 'p-3 rounded-lg text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-center';
                            msg.textContent = data.message || 'Message sent successfully!';
                            form.reset();
                        } else {
                            msg.className = 'p-3 rounded-lg text-xs font-semibold bg-red-500/20 text-red-400 border border-red-500/30 text-center';
                            msg.textContent = data.message || 'Failed to send message.';
                        }
                        setTimeout(() => msg.classList.add('hidden'), 5000);
                    } catch (err) {
                        msg.classList.remove('hidden');
                        msg.className = 'p-3 rounded-lg text-xs font-semibold bg-red-500/20 text-red-400 border border-red-500/30 text-center';
                        msg.textContent = 'Something went wrong. Please try again.';
                    } finally {
                        btn.disabled = false;
                        btn.innerHTML = orig;
                    }
                });
            }

            // Smooth scroll offset
            document.querySelectorAll('a[href^="#"]').forEach(a => {
                a.addEventListener('click', function(e) {
                    const id = this.getAttribute('href');
                    if (id === '#') return;
                    const el = document.querySelector(id);
                    if (el) {
                        e.preventDefault();
                        const top = el.getBoundingClientRect().top + window.pageYOffset - 72;
                        window.scrollTo({ top, behavior: 'smooth' });
                    }
                });
            });

            // ================= CERTIFICATES MODAL CONTROLLER =================
            const certDataEl = document.getElementById('certificates-data');
            const certDataList = certDataEl ? JSON.parse(certDataEl.textContent.trim()) : [];
            let currentCertIndex = 0;

            // Attach click listeners to all certificate preview buttons
            document.querySelectorAll('.open-cert-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const idx = parseInt(this.getAttribute('data-cert-index') || '0', 10);
                    window.openCertModal(idx);
                });
            });

            const certModal = document.getElementById('cert-modal');
            const modalCertTitle = document.getElementById('modal-cert-title');
            const modalCertSubtitle = document.getElementById('modal-cert-subtitle');
            const modalCertBody = document.getElementById('modal-cert-body');
            const modalCertDownload = document.getElementById('modal-cert-download');
            const modalCertNewTab = document.getElementById('modal-cert-newtab');
            const modalCertCounter = document.getElementById('modal-cert-counter');
            const closeCertModalBtn = document.getElementById('close-cert-modal');
            const modalPrevBtn = document.getElementById('modal-prev-btn');
            const modalNextBtn = document.getElementById('modal-next-btn');

            window.openCertModal = function(idx) {
                if (!certDataList || certDataList.length === 0) return;
                currentCertIndex = (idx + certDataList.length) % certDataList.length;
                const cert = certDataList[currentCertIndex];

                modalCertTitle.textContent = cert.title;
                modalCertSubtitle.textContent = `${cert.issuer} • ${cert.credentialId || cert.date}`;
                modalCertDownload.href = cert.file;
                modalCertNewTab.href = cert.file;
                modalCertCounter.textContent = `Certificate ${currentCertIndex + 1} of ${certDataList.length}`;

                modalCertBody.innerHTML = '';

                const displaySrc = cert.image || cert.file;
                const isPdf = !cert.image && cert.file.toLowerCase().endsWith('.pdf');
                if (isPdf) {
                    const iframe = document.createElement('iframe');
                    iframe.src = cert.file;
                    iframe.className = 'w-full h-[65vh] rounded-xl border border-white/10 bg-white shadow-xl';
                    iframe.title = cert.title;
                    modalCertBody.appendChild(iframe);
                } else {
                    const img = document.createElement('img');
                    img.src = displaySrc;
                    img.alt = cert.title;
                    img.className = 'max-h-[68vh] max-w-full object-contain rounded-xl shadow-2xl border border-white/10 mx-auto';
                    modalCertBody.appendChild(img);
                }

                certModal.classList.remove('hidden');
                certModal.classList.add('flex');
                document.body.style.overflow = 'hidden';
            };

            window.closeCertModal = function() {
                if (!certModal) return;
                certModal.classList.add('hidden');
                certModal.classList.remove('flex');
                modalCertBody.innerHTML = '';
                document.body.style.overflow = '';
            };

            if (closeCertModalBtn) {
                closeCertModalBtn.addEventListener('click', window.closeCertModal);
            }

            if (certModal) {
                certModal.addEventListener('click', (e) => {
                    if (e.target === certModal) window.closeCertModal();
                });
            }

            if (modalPrevBtn) {
                modalPrevBtn.addEventListener('click', () => window.openCertModal(currentCertIndex - 1));
            }

            if (modalNextBtn) {
                modalNextBtn.addEventListener('click', () => window.openCertModal(currentCertIndex + 1));
            }

            window.addEventListener('keydown', (e) => {
                if (!certModal || certModal.classList.contains('hidden')) return;
                if (e.key === 'Escape') window.closeCertModal();
                if (e.key === 'ArrowLeft') window.openCertModal(currentCertIndex - 1);
                if (e.key === 'ArrowRight') window.openCertModal(currentCertIndex + 1);
            });
        });
    </script>

    <!-- ================= CERTIFICATE VIEWER MODAL ================= -->
    <div id="cert-modal" class="fixed inset-0 z-[120] bg-black/85 backdrop-blur-md hidden items-center justify-center p-3 sm:p-6 transition-all duration-200">
        <div class="relative w-full max-w-4xl bg-navy-900 border border-white/15 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[92vh]">
            
            <!-- Modal Header -->
            <div class="p-4 sm:p-5 border-b border-white/10 flex items-center justify-between gap-3 bg-navy-950/90">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center shrink-0">
                        <iconify-icon icon="lucide:award" width="22"></iconify-icon>
                    </div>
                    <div class="min-w-0">
                        <h3 id="modal-cert-title" class="text-base sm:text-lg font-bold text-white truncate font-heading">
                            Certificate Title
                        </h3>
                        <p id="modal-cert-subtitle" class="text-xs text-gray-400 truncate">
                            Issuer • Credential ID
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                    <a id="modal-cert-download" href="#" download class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-xs font-semibold text-gray-200 bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white flex items-center gap-1.5 transition-colors" title="Download Certificate">
                        <iconify-icon icon="lucide:download" width="16" class="text-amber-400"></iconify-icon>
                        <span class="hidden sm:inline">Download</span>
                    </a>
                    <a id="modal-cert-newtab" href="#" target="_blank" rel="noopener noreferrer" class="p-2 sm:px-3 sm:py-1.5 rounded-lg text-xs font-semibold text-gray-200 bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white flex items-center gap-1.5 transition-colors" title="Open in New Tab">
                        <iconify-icon icon="lucide:external-link" width="16"></iconify-icon>
                        <span class="hidden sm:inline">New Tab</span>
                    </a>
                    <button id="close-cert-modal" type="button" class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/10 transition-colors" title="Close (Esc)">
                        <iconify-icon icon="lucide:x" width="20"></iconify-icon>
                    </button>
                </div>
            </div>

            <!-- Modal Body (Preview Container) -->
            <div id="modal-cert-body" class="p-4 sm:p-6 overflow-y-auto flex-grow flex items-center justify-center bg-navy-950/50 min-h-[340px]">
                <!-- Dynamic Content injected by JS -->
            </div>

            <!-- Modal Footer with Navigation & Details -->
            <div class="p-3 sm:p-4 border-t border-white/10 bg-navy-950/90 flex items-center justify-between text-xs text-gray-400">
                <span id="modal-cert-counter">Certificate 1 of 2</span>
                <div class="flex items-center gap-2">
                    <button id="modal-prev-btn" type="button" class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 hover:text-white hover:border-white/20 flex items-center gap-1 transition-colors">
                        <iconify-icon icon="lucide:chevron-left" width="16"></iconify-icon> Prev
                    </button>
                    <button id="modal-next-btn" type="button" class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 hover:text-white hover:border-white/20 flex items-center gap-1 transition-colors">
                        Next <iconify-icon icon="lucide:chevron-right" width="16"></iconify-icon>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Automatic Live Reload for seamless local development -->
    <script>
        (function() {
            if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
                let es;
                function startLiveReload() {
                    es = new EventSource('/live-reload');
                    es.onmessage = function(e) {
                        if (e.data === 'reload') {
                            window.location.reload();
                        }
                    };
                    es.onerror = function() {
                        es.close();
                        const checkInterval = setInterval(async () => {
                            try {
                                const res = await fetch(window.location.pathname + '?_ping=' + Date.now(), { method: 'HEAD', cache: 'no-store' });
                                if (res.ok) {
                                    clearInterval(checkInterval);
                                    window.location.reload();
                                }
                            } catch (e) {}
                        }, 700);
                    };
                }
                startLiveReload();
            }
        })();
    </script>
</body>
</html>
